  "cards": [
    {
      "dot": "cyan",
      "title": "停机规则(loop.decide)",
      "items": [
        "给了 --rounds N 只看轮数",
        "否则本轮删除 < 1% 或 < 100 细胞即 release",
        "或连续三轮删除 < 2%;--cap 触顶强制 release 并标记",
        "round 1 永不 release;绝不中途等人,疑点只在 release/needs_review 汇总",
        "下一轮输入 = 上轮幸存者,先验列改名 r(N-1)_* 供 agent 参考"
      ]
    },
    {
      "dot": "rose",
      "title": "记账与真删",
      "items": [
        "osp qc_removed.csv · msp annotation_removed.csv · zmip zmip_removed.csv",
        "ledger 对齐成 cell_ledger.csv,数目必须严丝合缝",
        "integrated.h5ad 永不改;幸存者在 annotated*.h5ad",
        "agent 输出经 host 校验:schema / 合并图 / 覆盖率 / 软预算"
      ]
    },
    {
      "dot": "emerald",
      "title": "目录与页面",
      "items": [
        "路径只在 ecarsi/layout.py 定义一次",
        "rounds/roundNN/{crosssample, zoomin, ledger, stats.txt, decision.txt}",
        "ecarsi.index 纯从磁盘推导,跑到一半也能看",
        "ecarsi.serve 默认 127.0.0.1;--ngrok 可公开"
      ]
    }
