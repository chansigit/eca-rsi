  "cards": [
    {
      "dot": "cyan",
      "title": "Main path",
      "items": [
        "QC and clustering run once per sample; integration and lineage refinement repeat as rounds",
        "Each round removes doublets, low-quality and ambient cells and re-integrates the survivors",
        "Every removed cell is recorded with a reason"
      ]
    },
    {
      "dot": "amber",
      "title": "When it stops",
      "items": [
        "A round that removes < 1% (or < 100) cells, or three rounds under 2%, and < 1000 cells",
        "The round count can also be fixed up front or adjusted while running"
      ]
    },
    {
      "dot": "slate",
      "title": "How agents are used",
      "items": [
        "LLM agents only choose labels and removals through typed tools; the host validates every submission",
        "Batch-driven removals are downgraded to flags; uncertain calls go to a review list",
        "Any provider (Doubao / Claude / DeepSeek) with fallback; cost is logged per step"
      ]
    }
