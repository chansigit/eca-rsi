# ~/.config/ecarsi/deployment.env: everything about eca-rsi that differs between machines.
# The launcher (control-plane.sh), the worker job script, Periscope's start script and the image helpers all read it
# (`set -a; . ~/.config/ecarsi/deployment.env; set +a`). To move to another machine, edit this file and results.json.
# Plain shell assignments; later lines may use earlier ones.

# The two images (ops/switch-images.sh rewrites these two lines)
IMG=/path/to/images/rsi-control-<stamp>.sif            # control image: Temporal, PostgreSQL, HQ, agent SDKs
SCIENCE_IMG=/path/to/images/rsi-science-<stamp>.sif    # compute image: the kernels; pool tasks and Periscope

# Runtime state (a shared, writable filesystem; mode 0700): control/ pool/ bridge/ runs/
STATE=/path/to/shared/scratch/eca
BASE=$STATE/control CONTROL=$STATE/control/durable-control POOL=$STATE/pool BRIDGE=$STATE/bridge

# Host directories the containers see: state, inputs, results and $HOME (comma-separated, each must exist)
BINDS=/scratch,/home

# A host Python 3.11+ for the worker launcher and add-worker (they call scontrol, ssh, nvidia-smi on the host)
HOSTPY=/usr/bin/python3

# Temporal dynamic config, hot-reloaded (workflow task timeout, history limits)
TEMPORAL_DYNAMIC_CONFIG=$HOME/.config/ecarsi/temporal.yaml

# Ports: change them only when another control plane shares the host
TEMPORAL_PORT=7633 DATABASE_PORT=55433 UI_PORT=8633

# Periscope (ops/start-periscope.sh): port, and the reserved ngrok domain if it is public (empty: local only)
PERISCOPE_PORT=8899 PERISCOPE_DOMAIN=

# Optional: COORDINATORS (default 4), STAGE_LIMIT_FLOORS, e.g.
# STAGE_LIMIT_FLOORS='{"max_in_flight_deg": 12, "max_in_flight_lineages": 6}'

# Development and image builds only (ops/run.sh --dev, ops/build-images*.sh)
CODE_HOME=/path/to/eca                                     # src/ (repositories), worktrees/, images/
DEV_WORKTREE=$CODE_HOME/worktrees/eca-rsi-dev              # the checkout ops/run.sh --dev and the image builds use
PYTEST_LIBS=/path/to/pytest-only                           # pytest for the images (they carry none)
BUILD_DIR=/path/to/node-local/scratch                      # image builds unpack sandboxes here
